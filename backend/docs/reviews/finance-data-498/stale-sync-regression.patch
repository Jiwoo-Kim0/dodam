+            LocalDateTime previousSyncTime = financeConnectionRepository.findByUserId(userId).orElseThrow().getLastSyncedAt();
+            releaseA.countDown();
+            var lateResponse = executionA.get(10, java.util.concurrent.TimeUnit.SECONDS);
+            var storedA = financeSyncRepository.findById(idA).orElseThrow();
+            var storedB = financeSyncRepository.findById(idB).orElseThrow();
+            var syncTimeAfterA = financeConnectionRepository.findByUserId(userId).orElseThrow().getLastSyncedAt();
+            System.out.printf("REVIEW late A: status=%s; B=%s; lastSyncedChanged=%s%n",
