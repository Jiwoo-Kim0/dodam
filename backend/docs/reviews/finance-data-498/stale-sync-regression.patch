+            jdbcTemplate.update("UPDATE finance_sync SET started_at = ? WHERE sync_id = ?",
+                    java.sql.Timestamp.valueOf(LocalDateTime.now().minusMinutes(11)), idA);
+            var executionB = executor.submit(() -> service.sync(userId,
+                    new com.ssafy.dodam.domain.finance.dto.FinanceSyncRequest("ACCOUNT")));
+            org.junit.jupiter.api.Assertions.assertTrue(enteredB.await(10, java.util.concurrent.TimeUnit.SECONDS));
+            Long idB = financeSyncRepository.findTopByUserIdOrderByStartedAtDescIdDesc(userId).orElseThrow().getId();
+            org.junit.jupiter.api.Assertions.assertEquals(FinanceSyncStatus.FAILED,
