DB_URL=
DB_USERNAME=
DB_PASSWORD=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
CORS_ALLOWED_ORIGINS=

# Access Token(HS256) 서명키. 32바이트 이상. 예: openssl rand -base64 48
JWT_SECRET=
# 민감 컬럼 암호화 / 조회 해시 키. 각각 Base64 32바이트. 예: openssl rand -base64 32
DATA_ENCRYPTION_KEY=
DATA_HASH_KEY=

# SSAFY 금융망 앱 관리자 API Key (회원가입 시 금융망 사용자 생성에 사용)
SSAFY_FINANCE_API_KEY=

# 소셜 로그인 (backend/docs/auth-social.md). 서버는 토큰 검증만 하므로 client secret은 쓰지 않는다.
# KAKAO_APP_ID: 카카오 개발자 콘솔 "앱 ID"(숫자). 비우면 다른 앱 토큰 검사 생략. GOOGLE_CLIENT_ID: 허용할 OAuth 클라이언트 ID(쉼표 구분)
KAKAO_APP_ID=
GOOGLE_CLIENT_ID=
