{
  "uid": "dodam-loadtest",
  "title": "도담 — 부하 테스트 (693)",
  "tags": [
    "dodam",
    "loadtest"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "description": "부하 테스트(S15P21D105-693) 관측용. 지표 정의·임계는 infra/docs/monitoring.md, 측정 기록은 load-test-records.md.",
  "panels": [
    {
      "type": "stat",
      "title": "수집 대상 정상",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "min(up)",
          "refId": "A",
          "instant": true
        }
      ],
      "description": "하나라도 0이면 그 잡의 지표가 통째로 비어 있다는 뜻이다. backend를 포함해 전부 본다."
    },
    {
      "type": "stat",
      "title": "DB풀 대기",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(hikaricp_connections_pending)",
          "refId": "A",
          "instant": true
        }
      ],
      "description": "0을 넘어 지속되면 커넥션 풀 고갈. 부하 병목의 1순위 신호다. 이 값이 오르면서 p95가 함께 튀면 원인은 쿼리가 아니라 풀 크기다."
    },
    {
      "type": "stat",
      "title": "5xx 오류율",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "(sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m])) or vector(0)) / sum(rate(http_server_requests_seconds_count[1m])) * 100",
          "refId": "A",
          "instant": true
        }
      ],
      "description": "1%를 넘으면 부하를 멈추고 원인부터 확인한다. 더 밀어도 쓸 수 없는 데이터만 쌓인다."
    },
    {
      "type": "stat",
      "title": "지연 p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[1m])) by (le))",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "처리량(req/s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count[1m]))",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "지연 분위수",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "description": "평균이 아니라 분위수로 본다. 느린 소수 요청은 평균에 묻혀 개선 전후 차이가 보이지 않는다."
    },
    {
      "type": "timeseries",
      "title": "느린 엔드포인트 p95 (상위 7)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "topk(7, histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[1m])) by (le, uri)))",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ],
      "description": "어느 경로가 느린지. 개선 대상을 고르는 근거."
    },
    {
      "type": "timeseries",
      "title": "HikariCP 커넥션 풀",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(hikaricp_connections_active)",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "expr": "sum(hikaricp_connections_idle)",
          "legendFormat": "idle",
          "refId": "B"
        },
        {
          "expr": "sum(hikaricp_connections_pending)",
          "legendFormat": "pending(대기)",
          "refId": "C"
        },
        {
          "expr": "max(hikaricp_connections_max)",
          "legendFormat": "max(상한)",
          "refId": "D"
        }
      ],
      "description": "active가 max에 붙고 pending이 오르면 풀 고갈이다. 기준선(2026-09-22) max=10은 HikariCP 기본값이며 MySQL max_connections는 151이다."
    },
    {
      "type": "timeseries",
      "title": "MySQL 서버",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "mysql_global_status_threads_connected",
          "legendFormat": "연결 수",
          "refId": "A"
        },
        {
          "expr": "mysql_global_variables_max_connections",
          "legendFormat": "max_connections",
          "refId": "B"
        },
        {
          "expr": "rate(mysql_global_status_slow_queries[1m])",
          "legendFormat": "슬로우 쿼리/초",
          "refId": "C"
        },
        {
          "expr": "rate(mysql_global_status_innodb_row_lock_waits[1m])",
          "legendFormat": "InnoDB 락 대기/초",
          "refId": "D"
        }
      ],
      "description": "앱 풀은 멀쩡한데 느리면 여기를 본다. 슬로우 쿼리나 락 대기가 오르면 쿼리·인덱스 문제다."
    },
    {
      "type": "timeseries",
      "title": "JVM 힙과 GC",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "used(사용)",
          "refId": "A"
        },
        {
          "expr": "sum(jvm_memory_committed_bytes{area=\"heap\"})",
          "legendFormat": "committed(확보)",
          "refId": "B"
        },
        {
          "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})",
          "legendFormat": "max(상한)",
          "refId": "C"
        },
        {
          "expr": "sum(rate(jvm_gc_pause_seconds_sum[1m]))",
          "legendFormat": "GC 정지(초/초)",
          "refId": "D"
        }
      ],
      "description": "used가 committed에 붙으면 JVM이 힙을 늘린다. committed가 max에 닿은 뒤에도 used가 높고 GC 정지가 오르면 힙 부족이다. 비율(%)은 쓰지 않는다 — max는 GC가 세대 크기를 조정하면서 값이 변해 분모로 쓸 수 없다. 설정은 -XX:MaxHeapSize=1g, InitialHeapSize=256m."
    },
    {
      "type": "timeseries",
      "title": "호스트 CPU·메모리 (백엔드 몫 포함)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "호스트 CPU 사용률(%)",
          "refId": "A"
        },
        {
          "expr": "process_cpu_usage * 100",
          "legendFormat": "백엔드 프로세스 CPU(%)",
          "refId": "B"
        },
        {
          "expr": "node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes * 100",
          "legendFormat": "메모리 여유(%)",
          "refId": "C"
        }
      ],
      "description": "호스트 전체 CPU와 그중 백엔드가 쓰는 몫을 함께 본다. 호스트 CPU는 높은데 백엔드 몫이 낮으면 범인은 MySQL·Jenkins 등 다른 컨테이너다(앱을 고쳐도 소용없다). 둘이 같이 오르면 백엔드가 원인이다. 컨테이너별 세부 내역은 없다 — cAdvisor가 이 호스트의 Docker 29 containerd 스토어를 지원하지 않는다(day-13 24절)."
    },
    {
      "type": "timeseries",
      "title": "Redis",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "legendFormat": "사용 메모리",
          "refId": "A"
        },
        {
          "expr": "rate(redis_evicted_keys_total[1m])",
          "legendFormat": "eviction/초",
          "refId": "B"
        },
        {
          "expr": "rate(redis_commands_processed_total[1m])",
          "legendFormat": "명령/초",
          "refId": "C"
        }
      ],
      "description": "eviction이 0을 넘으면 캐시가 밀려나는 중이다. 코치 응답 캐시 적중률이 떨어져 외부 API 호출이 는다."
    },
    {
      "type": "timeseries",
      "title": "컨테이너별 CPU (상위 6)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "topk(6, rate(container_cpu_usage_seconds_total{container_id!=\"\"}[1m]) * 100)",
          "legendFormat": "{{container_id}}",
          "refId": "A"
        }
      ],
      "description": "누가 CPU를 먹는지. 이름 대신 12자리 컨테이너 ID로 나오므로 `docker ps`로 대조한다. 호스트 CPU가 높은데 백엔드가 아니면 여기서 범인을 찾는다."
    },
    {
      "type": "timeseries",
      "title": "컨테이너별 메모리 (상위 6)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "topk(6, container_memory_working_set_bytes{container_id!=\"\"})",
          "legendFormat": "{{container_id}}",
          "refId": "A"
        }
      ],
      "description": "working set 기준. MySQL 버퍼풀이 커지는지, 백엔드 힙 외 메모리가 느는지 본다. ID는 `docker ps`의 CONTAINER ID와 같다."
    }
  ]
}
