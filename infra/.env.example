# 이 파일은 키 이름만 채운 템플릿입니다. 실제 값은 넣지 말고, EC2 위 infra/.env(gitignore됨)에만 채워넣으세요.

# Jenkins / 배포 (Day 2)
# DOCKER_GID: EC2에서 `getent group docker | cut -d: -f3` 실행 결과
DOCKER_GID=
# APP_DIR: EC2의 배포용 체크아웃 경로 (기본값 /home/ubuntu/app)
APP_DIR=/home/ubuntu/app

# MySQL (Day 2에서 앞당겨 구성)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=dodam
MYSQL_USER=dodam
MYSQL_PASSWORD=

# Redis (Day 2에서 앞당겨 구성)
REDIS_PASSWORD=

# Backend (Day 2)
# CORS_ALLOWED_ORIGINS: 쉼표 구분. 앱(Expo) 개발 중에는 http://localhost:8081 등을 추가
CORS_ALLOWED_ORIGINS=http://localhost:8081

# Backend / Auth (Day 5)
JWT_SECRET=
# 민감 컬럼 암호화(AES-256-GCM) / 조회 해시(HMAC-SHA-256) 키. 각각 `openssl rand -base64 32`
# ★ 잃으면 account_no_encrypted 등 암호화 컬럼을 복구할 수 없다. DB 백업과 별도 장소에 함께 백업할 것 (security.md R5)
DATA_ENCRYPTION_KEY=
DATA_HASH_KEY=

# Backend / 민감정보 해시 (Day 8)
# NUMBER_HASH_KEY: 계좌·카드번호 HMAC-SHA256 해시 키. 미설정 시 backend 컨테이너가 기동 실패한다.
# 키가 바뀌면 기존 *_hash 값과 매칭이 깨지므로 한번 정하면 고정. 로컬과는 분리된 운영 전용 값을 쓴다.
# 생성: openssl rand -base64 48
NUMBER_HASH_KEY=

# 외부 연동 (Day 5, 7)
OPENAI_API_KEY=
SSAFY_FINANCE_API_KEY=
FCM_SERVICE_ACCOUNT_PATH=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# KAKAO_APP_ID: 카카오 개발자 콘솔 "앱 ID"(숫자, REST API 키와 다름). 백엔드가 access token이 우리 앱 것인지 대조할 때 쓴다. 비우면 검사 생략.
KAKAO_APP_ID=
# GOOGLE_CLIENT_ID: 백엔드가 구글 ID token의 aud로 허용할 OAuth 클라이언트 ID. Android·웹 클라이언트를 모두 쓰면 쉼표로 이어 적는다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 모니터링 (Day 6)
# Grafana 관리자 계정. 외부에는 nginx의 /grafana/ 로만 노출되므로 강한 비밀번호를 쓸 것.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
# Mattermost Incoming Webhook URL — 배포 실패/서비스 이상 알림 전송용
# Mattermost → Integrations → Incoming Webhooks 에서 생성
MATTERMOST_WEBHOOK_URL=
