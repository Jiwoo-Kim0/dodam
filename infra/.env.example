# 이 파일은 키 이름만 채운 템플릿입니다. 실제 값은 넣지 말고, EC2 위 infra/.env(gitignore됨)에만 채워넣으세요.

# Jenkins / 배포 (Day 2)
# DOCKER_GID: EC2에서 `getent group docker | cut -d: -f3` 실행 결과
DOCKER_GID=
# APP_DIR: EC2의 배포용 체크아웃 경로 (기본값 /home/ubuntu/app)
APP_DIR=/home/ubuntu/app

# MySQL (Day 2에서 앞당겨 구성)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=dodam
MYSQL_USER=dodam
MYSQL_PASSWORD=

# Redis (Day 2에서 앞당겨 구성)
REDIS_PASSWORD=

# Backend (Day 2)
# CORS_ALLOWED_ORIGINS: 쉼표 구분. 앱(Expo) 개발 중에는 http://localhost:8081 등을 추가
CORS_ALLOWED_ORIGINS=http://localhost:8081

# Backend / Auth (Day 5)
JWT_SECRET=
# 민감 컬럼 암호화(AES-256-GCM) / 조회 해시(HMAC-SHA-256) 키. 각각 `openssl rand -base64 32`
# ★ 잃으면 account_no_encrypted 등 암호화 컬럼을 복구할 수 없다. DB 백업과 별도 장소에 함께 백업할 것 (security.md R5)
DATA_ENCRYPTION_KEY=
DATA_HASH_KEY=

# Backend / 민감정보 해시 (Day 8)
# NUMBER_HASH_KEY: 계좌·카드번호 HMAC-SHA256 해시 키. 미설정 시 backend 컨테이너가 기동 실패한다.
# 키가 바뀌면 기존 *_hash 값과 매칭이 깨지므로 한번 정하면 고정. 로컬과는 분리된 운영 전용 값을 쓴다.
# 생성: openssl rand -base64 48
NUMBER_HASH_KEY=

# 외부 연동 (Day 5, 7)
OPENAI_API_KEY=
SSAFY_FINANCE_API_KEY=
FCM_SERVICE_ACCOUNT_PATH=

# 소셜 로그인 (backend/docs/auth-social.md, S15P21D105-611 / 2026-09-15 백엔드 구현 완료)
# 앱이 공급자 SDK로 로그인해 받은 토큰을 서버가 공급자에 검증만 한다.
# 서버가 authorization code를 교환하지 않으므로 **client secret은 양쪽 모두 필요 없다.**
#   (KAKAO_CLIENT_ID / KAKAO_CLIENT_SECRET / GOOGLE_CLIENT_SECRET 은 2026-09-16에 제거했다.
#    서버 리다이렉트 방식으로 바꾸지 않는 한 쓸 자리가 없고, "어느 secret을 넣지?" 하는
#    혼동만 만든다. 방식을 바꾼다면 그때 다시 추가할 것)
#
# KAKAO_APP_ID: 카카오 개발자 콘솔의 "앱 ID"(숫자). 앱 키 4종과도, REST API 키와도 다른 값이다.
#   앱 생성 시 자동 부여되며 콘솔 URL(.../console/app/<앱ID>)과 앱 설정 요약에서 확인한다.
#   백엔드가 access token이 우리 앱에서 발급된 것인지
#   대조할 때만 쓴다(app.social.kakao.app-id). 비우면 그 검사를 생략하고 로그인은 동작한다.
KAKAO_APP_ID=
# GOOGLE_CLIENT_ID: 백엔드가 구글 ID token의 aud로 허용할 OAuth 클라이언트 ID.
#   Android·웹 클라이언트를 모두 쓰면 쉼표로 이어 적는다.
#   ⚠️ 비어 있으면 구글 로그인이 런타임 503(SOCIAL_PROVIDER_UNAVAILABLE)로 실패한다.
#      백엔드 기동은 성공하므로 겉보기로는 드러나지 않는다.
GOOGLE_CLIENT_ID=

# 모니터링 (Day 6)
# Grafana 관리자 계정. 외부에는 nginx의 /grafana/ 로만 노출되므로 강한 비밀번호를 쓸 것.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
# Mattermost Incoming Webhook URL — 배포 실패/서비스 이상 알림 전송용
# Mattermost → Integrations → Incoming Webhooks 에서 생성
MATTERMOST_WEBHOOK_URL=
