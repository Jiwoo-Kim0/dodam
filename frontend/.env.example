# 배포 API Base URL. apiClient가 /v1/... 경로를 붙이므로 /api로 끝나야 한다. (예: https://example.com/api)
EXPO_PUBLIC_API_BASE_URL=
# 카카오 개발자 콘솔 "네이티브 앱 키". 공개 식별자라 번들에 포함돼도 되지만 REST API 키·client secret은 절대 넣지 않는다.
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
# 구글 클라우드 콘솔의 "웹 애플리케이션" 유형 OAuth 클라이언트 ID. Android SDK가 id_token을 받을 때 쓴다.
# 서버 .env의 GOOGLE_CLIENT_ID와 같은 값이어야 하고, Client Secret은 앱에 넣지 않는다.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# 로그인 화면의 "개발용 로그인"(이메일·비밀번호) 노출 여부. "true"일 때만 보인다.
# 개발 실행(__DEV__)에서는 이 값이 없어도 항상 보이고, 릴리스 빌드에서만 이 값을 본다.
# 내부 배포 APK는 eas.json의 development·preview 프로필에서 켜 둔다.
EXPO_PUBLIC_ENABLE_DEMO_LOGIN=
